# Google OAuth 2.0 Web client ID (not a client secret)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MongoDB URI is loaded from the ignored atlas-credentials.env file.
MONGODB_DB=tic_tac_toe

